# Resend (transactional email) — https://resend.com
RESEND_API_KEY=
# Verified sender, e.g. "Gwags Website <notifications@mail.gwags.org>"
RESEND_FROM_EMAIL=

# Recipients for form notifications
CONTACT_EMAIL=contact@gwags.org
PARTNERSHIPS_EMAIL=contact@gwags.org

# Stripe (donations)
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
SITE_URL=

# Webhook idempotency (optional, not yet provisioned) — Upstash Redis REST
# API, used to de-duplicate retried Stripe webhook deliveries. If unset, the
# webhook processes every delivery with no dedup (today's behavior) instead
# of failing. See lib/idempotency.ts.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
