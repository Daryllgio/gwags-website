# Resend (transactional email) — https://resend.com
RESEND_API_KEY=
# Verified sender, e.g. "Gwags Website <notifications@mail.gwags.org>"
RESEND_FROM_EMAIL=

# Recipients for form notifications
CONTACT_EMAIL=contact@gwags.org
PARTNERSHIPS_EMAIL=contact@gwags.org

# Stripe (donations)
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
SITE_URL=

# Webhook idempotency (optional) — used to de-duplicate retried Stripe
# webhook deliveries. Auto-injected into Production/Preview by the Vercel
# Upstash (Marketplace) integration once provisioned — no manual setup
# needed beyond adding that integration. If unset, the webhook processes
# every delivery with no dedup instead of failing. See lib/idempotency.ts.
KV_REST_API_URL=
KV_REST_API_TOKEN=
