# Resend (transactional email) — https://resend.com
RESEND_API_KEY=
# Verified sender, e.g. "Gwags Website <notifications@mail.gwags.org>"
RESEND_FROM_EMAIL=

# Recipients for form notifications — centralized in lib/emailRouting.ts,
# read there rather than scattered across route handlers.
CONTACT_EMAIL=contact@gwags.org
PROGRAMS_EMAIL=programs@gwags.org
DONATIONS_EMAIL=donate@gwags.org
# Deprecated: superseded by CONTACT_EMAIL for the Partnership form. Left in
# place (unused by code) rather than removed from Vercel.
PARTNERSHIPS_EMAIL=contact@gwags.org

# Neon Postgres (gwags-core) — auto-injected per environment by the Vercel/
# Neon integration (Development env points at the Neon dev branch, Production
# at the Neon production branch). Pull with:
#   vercel env pull .env.local --environment=development
DATABASE_URL=
DATABASE_URL_UNPOOLED=

# Feature flags — see lib/featureFlags.ts. Only read/enforced when
# VERCEL_ENV=production (local `next dev` and Preview are always open); set
# to 'true' in Vercel's Production environment when ready to launch.
SCHOLARS_APPLICATION_OPEN=false

# Stripe (donations)
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
SITE_URL=

# Webhook idempotency (optional) — used to de-duplicate retried Stripe
# webhook deliveries. Auto-injected into Production/Preview by the Vercel
# Upstash (Marketplace) integration once provisioned — no manual setup
# needed beyond adding that integration. If unset, the webhook processes
# every delivery with no dedup instead of failing. See lib/idempotency.ts.
KV_REST_API_URL=
KV_REST_API_TOKEN=
